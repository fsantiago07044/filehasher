<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FileHasher</AssemblyName>
    <RootNamespace>FileHasher</RootNamespace>
    <Version>0.2.1</Version>
    <Company>FileHasher</Company>
    <Product>FileHasher</Product>
    <Copyright>Copyright © 2026 FSP Productions, LLC</Copyright>
    <ApplicationIcon>assets\app-icon\hash-icon.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Bundle native libraries (wpfgfx_cor3.dll, D3DCompiler_47_cor3.dll, etc.)
      inside FileHasher.exe instead of shipping them as sidecars. Only takes
      effect when PublishSingleFile=true; harmless for regular Build. Without
      this, "single-file" publish leaves ~5 native DLLs alongside the exe.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The .ico is embedded into the assembly so MainForm can load it via
      GetManifestResourceStream("hash-icon.ico") at runtime. <ApplicationIcon>
      above embeds the same file as the PE Win32 resource (Explorer / taskbar
      / alt-tab); this entry covers Form.Icon, which WinForms does not derive
      from <ApplicationIcon> automatically.
    -->
    <EmbeddedResource Include="assets\app-icon\hash-icon.ico">
      <LogicalName>hash-icon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    EXPERIMENTAL (feature/msi-inner-scan branch). Pulls in WiX DTF wrappers
    around the Windows Installer COM API. Used by MsiExtractor.cs to enumerate
    and extract files contained inside .msi installer packages so they can be
    hashed individually. Adds roughly 1.5 MB to the bundled self-contained
    exe. If this branch is abandoned, remove this ItemGroup and MsiExtractor.cs.
  -->
  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller"          Version="4.0.6" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller.Package"  Version="4.0.6" />
  </ItemGroup>

  <!--
    EXPERIMENTAL (feature/msi-inner-scan branch). Expose internal types
    (MsiExtractor and its helpers) to the test project so the security guards
    can be unit-tested directly without driving the UI. SDK-style projects
    inject this into the generated AssemblyInfo.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="FileHasherApp.Tests" />
  </ItemGroup>

  <!--
    To publish a self-contained single-file executable (run from the FileHasherApp folder):

      dotnet publish -c Release -r win-x64 -p:SelfContained=true -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -p:DebugType=embedded

    Output: bin\Release\net8.0-windows\win-x64\publish\FileHasher.exe
  -->

</Project>
