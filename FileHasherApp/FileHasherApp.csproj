<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FileHasher</AssemblyName>
    <RootNamespace>FileHasher</RootNamespace>
    <!--
      In-progress version. The About box and the support mailto subject read
      this (via HelpContent.AppVersion), so keep it at the version being worked
      on, not the last released one.

      NOTE: FileHasher.Core.csproj carries a matching <Version>, and since
      HelpContent moved into Core it is CORE's informational version that the
      About box actually reports. Release builds are safe either way because CI
      passes -p:Version=<tag> as a global property, which propagates to Core
      through the ProjectReference (verified). Local builds do not, so bump the
      two together or the About box will show a stale number.
    -->
    <Version>0.5.0-beta.1</Version>
    <Company>FileHasher</Company>
    <Product>FileHasher</Product>
    <Copyright>Copyright © 2026 FSP Productions, LLC</Copyright>
    <ApplicationIcon>assets\app-icon\hash-icon.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Reproducibility: pin the runtime patch, not just the SDK. global.json
      pins the SDK to 10.0.400, whose bundled runtime is 10.0.11; naming that
      version here keeps the self-contained publish bound to the exact
      Microsoft.NETCore.App and Microsoft.WindowsDesktop.App runtime packs
      (verified: this property drives both) instead of leaving it implied by
      whatever SDK build resolves the framework references. Bump this together
      with the global.json SDK pin, and keep the pair consistent: a version
      that does not match the SDK's bundled runtime still builds, but the packs
      then come from nuget.org rather than the local SDK install.
    -->
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <!--
      Bundle native libraries (wpfgfx_cor3.dll, D3DCompiler_47_cor3.dll, etc.)
      inside FileHasher.exe instead of shipping them as sidecars. Only takes
      effect when PublishSingleFile=true; harmless for regular Build. Without
      this, "single-file" publish leaves ~5 native DLLs alongside the exe.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The .ico is embedded into the assembly so MainForm can load it via
      GetManifestResourceStream("hash-icon.ico") at runtime. <ApplicationIcon>
      above embeds the same file as the PE Win32 resource (Explorer / taskbar
      / alt-tab); this entry covers Form.Icon, which WinForms does not derive
      from <ApplicationIcon> automatically.
    -->
    <EmbeddedResource Include="assets\app-icon\hash-icon.ico">
      <LogicalName>hash-icon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The hashing engine, the sidecar verifier, the MSI reader, the help text and
    the DTOs all live in FileHasher.Core so the planned CLI can drive exactly
    the same code (docs/cli-design.md). This project keeps only the WinForms
    layer: MainForm, HelpForm, Program and ColorProgressBar.

    The WiX DTF package references moved to Core along with MsiExtractor.cs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\FileHasher.Core\FileHasher.Core.csproj" />
  </ItemGroup>

  <!--
    EXPERIMENTAL (feature/msi-inner-scan branch). Expose internal types
    (MsiExtractor and its helpers) to the test project so the security guards
    can be unit-tested directly without driving the UI. SDK-style projects
    inject this into the generated AssemblyInfo.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="FileHasherApp.Tests" />
  </ItemGroup>

  <!--
    To publish a self-contained single-file executable (run from the FileHasherApp folder):

      dotnet publish -c Release -r win-x64 -p:SelfContained=true -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -p:DebugType=embedded

    Output: bin\Release\net10.0-windows\win-x64\publish\FileHasher.exe
  -->

</Project>
