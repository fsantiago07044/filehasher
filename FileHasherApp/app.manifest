<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="FileHasher.app"/>

  <!-- UAC: start as normal user; the app re-launches itself with runas when elevation is needed -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Windows 10 / Windows 11 compatibility -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- Enable modern visual styles and DPI awareness -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        System, not PerMonitorV2, deliberately, and it works only together with
        the AutoScaleMode.Font setting on MainForm and HelpForm. Change one
        without the other and the layout breaks again.

        PerMonitorV2 tells Windows "do not scale me, I lay myself out at the
        real DPI". Neither awareness level makes Windows bitmap-scale a window
        at the DPI it launched at, so with hard-coded pixel coordinates and no
        auto-scaling this form clipped at any scaling above 100%: Microsoft
        Store certification rejected 0.3.1 for it under policy 10.1.2.10,
        reproduced here at 150% and 175%. The forms now scale their own layout,
        which is what actually fixes it.

        System is kept rather than PerMonitorV2 because it is the combination
        that was tested. Under System, a window dragged to a monitor with
        different scaling is bitmap-scaled by Windows: slightly soft, still
        correctly laid out. PerMonitorV2 would additionally require handling
        live DPI-change events, which is untested here.
      -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">System</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>
