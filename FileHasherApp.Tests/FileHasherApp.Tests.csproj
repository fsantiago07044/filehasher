<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core"                  Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3"                  Version="4.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"      Version="17.9.0" />
    <PackageReference Include="xunit"                       Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio"   Version="2.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    NuGet audit suppressions for advisories reviewed and determined to not
    apply to this project's threat model. Keep this list in sync with the
    $suppressedAdvisories array in the audit job's script in .gitlab-ci.yml
    — the csproj entry silences the NU1903 / NU1904 warning during local
    `dotnet restore`, the script entry silences the same finding in the CI
    audit job's package vulnerability scan output (`dotnet list package`
    does not honor NuGetAuditSuppress, which is why the script needs its
    own parallel list).
  -->
  <ItemGroup>
    <!--
      GHSA-rxg9-xrhp-64gj — System.Drawing.Common 5.0.2 (transitive via FlaUI).
      Test-only dependency, never shipped to end users. The test process does
      not load attacker-controlled images or otherwise reach the vulnerable
      GDI+ paths described in the advisory. Reviewed 2026-05.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxg9-xrhp-64gj" />
  </ItemGroup>

</Project>
