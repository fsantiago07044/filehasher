<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Match the app project's x64 target. Without this the test assembly
      builds as AnyCPU/MSIL and MSBuild warns about the architecture mismatch
      against the x64 FileHasher.dll project reference on every build.
    -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core"                  Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3"                  Version="4.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"      Version="18.9.0" />
    <PackageReference Include="xunit"                       Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio"   Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    EXPERIMENTAL (feature/msi-inner-scan branch). Project-reference the main
    app so the unit tests in MsiExtractorTests can resolve the internal
    MsiExtractor type via InternalsVisibleTo. The existing FlaUI integration
    tests still launch the built FileHasher.exe out-of-process via FlaUI;
    they don't depend on the project reference. AppFixture.FindExe walks up
    from AppContext.BaseDirectory looking for the canonical exe in
    FileHasherApp\bin\<config>\net10.0-windows\, so the duplicate that the
    project reference drops next to the test assembly is incidental and
    ignored at runtime.
  -->
  <ItemGroup>
    <ProjectReference Include="..\FileHasherApp\FileHasherApp.csproj" />
  </ItemGroup>

  <!--
    NuGet audit suppressions for advisories reviewed and determined to not
    apply to this project's threat model. Keep this list in sync with the
    $suppressedAdvisories array in the audit job's script in .gitlab-ci.yml
    — the csproj entry silences the NU1903 / NU1904 warning during local
    `dotnet restore`, the script entry silences the same finding in the CI
    audit job's package vulnerability scan output (`dotnet list package`
    does not honor NuGetAuditSuppress, which is why the script needs its
    own parallel list).
  -->
  <ItemGroup>
    <!--
      GHSA-rxg9-xrhp-64gj — System.Drawing.Common 5.0.2 (transitive via FlaUI).
      Test-only dependency, never shipped to end users. The test process does
      not load attacker-controlled images or otherwise reach the vulnerable
      GDI+ paths described in the advisory. Reviewed 2026-05.
      Inert since the net10.0-windows move: the .NET 10 SDK prunes
      framework-provided packages from the restore graph, so
      System.Drawing.Common no longer resolves at all and the vulnerability
      scan comes back clean. Kept as a safety net in case a future dependency
      reintroduces it.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxg9-xrhp-64gj" />
  </ItemGroup>

  <!--
    EXPERIMENTAL (feature/msi-inner-scan branch). Test fixtures used by the
    upcoming MSI inner-scan test class. The wildcard glob ships every file
    under fixtures/ alongside the test assembly so tests can locate them via
    Path.Combine(AppContext.BaseDirectory, "fixtures", "<name>"). Drop this
    ItemGroup if the branch is abandoned.
  -->
  <ItemGroup>
    <Content Include="fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
